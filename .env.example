# 本地开发留空即可通过 Vite 同源代理；跨域生产部署时填写 Node API 地址。
VITE_MUSIC_API_BASE=

# Node API 跨域部署时填写前端 Origin，例如 https://hzagaming.github.io。
CORS_ORIGIN=http://localhost:5173

# Compose 对外端口；生产环境仍需通过可信反向代理或托管平台提供 HTTPS。
LISTENER_API_PORT=3000

# 以下服务端变量需由 shell 或部署平台注入，Node.js 18 不会自动读取此文件。
# MusicBrainz 默认使用项目仓库地址作为联系标识；部署者可覆盖为维护邮箱或网站。
MUSICBRAINZ_CONTACT=

# 需在 Google Cloud 启用 YouTube Data API v3；Key 仅保留在服务端。
# search.list 每次搜索消耗 100 配额单位，本项目固定只请求第一页并复用短期缓存。
YOUTUBE_API_KEY=

# Audius 公开只读搜索无需 Key；如部署者拥有开发者 Key，可选填并始终仅留服务端。
# 配置前请先阅读并接受 https://audius.co/legal/api-terms。
AUDIUS_API_KEY=

# Brave Web Search 官方服务端 Key；用于检索其余平台公开且能通过地址/ID白名单验证的曲目页面。
BRAVE_SEARCH_API_KEY=

# 可选 Provider 白名单；留空时默认启用 Apple、Audius、MusicBrainz、Wikimedia、实验性网易元数据，并按凭据启用 YouTube Music 和公开网页目录来源。
MUSIC_ENABLED_PROVIDERS=
ENABLE_LOCAL_FIXTURE=false
ENABLE_NETEASE=true

# Provider 安全边界与缓存。重试最多允许 1 次，响应上限最大 10 MiB。
MUSIC_PROVIDER_TIMEOUT_MS=8000
MUSIC_PROVIDER_RESPONSE_LIMIT_BYTES=2097152
MUSIC_MAX_RETRIES=1
MUSIC_MAX_CONCURRENT_PROVIDERS=4
MUSIC_CACHE_TTL_MS=30000
MUSIC_OPERATION_CACHE_TTL_MS=60000
MUSIC_NEGATIVE_CACHE_TTL_MS=5000
MUSIC_API_RATE_LIMIT=60

# 账号、云同步与隐私。数据库目录会自动创建；生产 HTTPS 应保持安全 Cookie 开启。
LISTENER_DB_PATH=data/listener.sqlite
LISTENER_SESSION_TTL_MS=2592000000
LISTENER_SECURE_COOKIES=false

# 仅填写可信反向代理写入的两位国家代码 Header；留空时使用浏览器语言或手动地区。
LISTENER_COUNTRY_HEADER=

# 封面与授权音频下载上限；音频只流式转发，不写入磁盘或缓存。
LISTENER_ARTWORK_MAX_BYTES=8388608
LISTENER_AUDIO_DOWNLOAD_MAX_BYTES=134217728
LISTENER_AUDIO_DOWNLOAD_TIMEOUT_MS=120000
